FLAVORS = {
  dev: {
    bundle_id: "com.glowante.salon.dev",
    dart_flavor: "dev",
  },
  staging: {
    bundle_id: "com.glowante.salon.test",
    dart_flavor: "test",
  },
  prod: {
    bundle_id: "com.glowante.salon",
    dart_flavor: "prod",
  },
}

# One App Store Connect API key covers all three apps/bundle IDs on this
# team — see ios/fastlane/README.md for how to generate it.
def connect_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_FILEPATH"] || "./AuthKey.p8"
  )
end

# Figures out a build number that's guaranteed not to collide with anything
# already uploaded, so pubspec.yaml's `+N` never has to be bumped by hand.
# Takes the current local number and the highest build number already seen
# on TestFlight across all three bundle IDs, then uses candidate_max + 1.
def latest_known_testflight_build_numbers
  builds = []
  connect_api_key
  FLAVORS.each_value do |info|
    begin
      build = latest_testflight_build_number(app_identifier: info[:bundle_id])
      builds << build if build
    rescue => e
      UI.important(
        "Skipping TestFlight build number lookup for #{info[:bundle_id]}: #{e.message}"
      )
    end
  end
  builds
end

def bump_pubspec_build_number!
  project_root = File.expand_path("../..", __dir__)
  pubspec_path = File.join(project_root, "pubspec.yaml")
  content = File.read(pubspec_path)

  match = content.match(/^version:\s*(\d+\.\d+\.\d+)\+(\d+)$/)
  UI.user_error!("Could not find a `version: X.Y.Z+N` line in pubspec.yaml") unless match
  version_name = match[1]
  current_build = match[2].to_i

  candidates = [current_build] + latest_known_testflight_build_numbers
  next_build = candidates.max + 1

  File.write(
    pubspec_path,
    content.sub(
      /^version:\s*\d+\.\d+\.\d+\+\d+$/,
      "version: #{version_name}+#{next_build}"
    )
  )
  UI.success("pubspec.yaml build number -> #{version_name}+#{next_build}")
end

before_all do
  bump_pubspec_build_number!
end

def build_and_upload(flavor)
  info = FLAVORS.fetch(flavor)
  project_root = File.expand_path("../..", __dir__)

  Dir.chdir(project_root) do
    sh(
      "flutter", "build", "ipa",
      "--flavor", flavor.to_s,
      "--release",
      "--dart-define=APP_FLAVOR=#{info[:dart_flavor]}"
    )
  end

  ipa_path = Dir.glob(
    File.join(project_root, "build/ios/ipa/*.ipa")
  ).max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa found under build/ios/ipa after build") unless ipa_path

  connect_api_key
  upload_to_testflight(
    ipa: ipa_path,
    app_identifier: info[:bundle_id],
    skip_waiting_for_build_processing: true
  )
end

platform :ios do
  desc "Build & upload the dev flavor to TestFlight"
  lane(:dev) { build_and_upload(:dev) }

  desc "Build & upload the staging (test) flavor to TestFlight"
  lane(:staging) { build_and_upload(:staging) }

  desc "Build & upload the prod flavor to TestFlight"
  lane(:prod) { build_and_upload(:prod) }

  desc "Build & upload all three flavors to TestFlight, one after another"
  lane :all do
    dev
    staging
    prod
  end
end
